# VERCEL — CRIE 3 VARIÁVEIS SEPARADAS
# Em "Name", use somente o nome. Em "Value", use somente o valor.

# 1) Name: APPS_SCRIPT_API_URL
# Value exemplo (NÃO copie o exemplo): https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec
APPS_SCRIPT_API_URL=

# 2) Name: APPS_SCRIPT_PROXY_SECRET
# Value: copie somente o segredo exibido por "Configurar ponte Vercel (passo a passo)".
APPS_SCRIPT_PROXY_SECRET=

# 3) Name: ASAAS_WEBHOOK_TOKEN
# Value: copie somente o token de webhook exibido na mesma janela.
# NÃO é a ASAAS_API_KEY.
ASAAS_WEBHOOK_TOKEN=
