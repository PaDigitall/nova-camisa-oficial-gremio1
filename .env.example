# Opcional: esta versão já possui a URL pública atual do Apps Script como fallback.
# Se um dia publicar um novo deployment do Apps Script, atualize esta variável.
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/AKfycbyJnfhx5RS1gFnpPnFV9e2PdhQpq1gqoDXo4rOFVyHMjZ0PqisUAEWAyPUPBRNOH0pf/exec

# Deve conter EXATAMENTE o mesmo valor salvo como VERCEL_PROXY_SECRET
# nas Propriedades do Script do Apps Script.
APPS_SCRIPT_PROXY_SECRET=configure_somente_na_vercel

# Token próprio do webhook configurado no Asaas.
# Nunca use a API key do Asaas aqui.
ASAAS_WEBHOOK_TOKEN=configure_somente_na_vercel
